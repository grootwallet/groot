{
    admin off
    auto_https off
    persist_config off
    # HTTP errors carry request URLs and custom headers even with access logs off.
    log default {
        exclude http.log.error
    }
    log private_http_errors {
        include http.log.error
        output discard
    }
    servers {
        protocols h1 h2
        timeouts {
            read_header 5s
            read_body 8s
            write 15s
            idle 30s
        }
        max_header_size 16KB
    }
}

:8443 {
    tls /certs/cert.pem /certs/key.pem
    log {
        output discard
    }
    route {
        @wrongAuthority expression `{http.request.hostport} != "{$GROOT_SANDBOX_AUTHORITY}"`
        respond @wrongAuthority 403
        header {
            -Server
            Referrer-Policy no-referrer
            X-Content-Type-Options nosniff
            X-Frame-Options DENY
            Strict-Transport-Security "max-age=86400"
            Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=()"
            X-Robots-Tag "noindex, nofollow, noarchive"
        }
        basic_auth {
            tester {$GROOT_SANDBOX_ACCESS_HASH}
        }
        request_body {
            max_size 8KB
        }
        @api path /v1/* /healthz
        handle @api {
            reverse_proxy backend:5200 {
                header_up -Authorization
                header_up -Forwarded
                header_up -X-Forwarded-For
                header_up -X-Forwarded-Host
                header_up -X-Forwarded-Proto
                header_up -X-Real-IP
                transport http {
                    dial_timeout 2s
                    response_header_timeout 12s
                }
            }
        }
        @root path /
        redir @root /marketplace/backend 302
        @pages path /marketplace /marketplace/ /marketplace/backend /marketplace/backend/
        handle @pages {
            root * /srv/site
            header Cache-Control no-store
            header Content-Security-Policy "@@CSP@@"
            rewrite * /index.html
            file_server
        }
        @assets path /_app/* /fonts/* /theme-init.js /locale-init.js /favicon.svg /site.webmanifest
        handle @assets {
            root * /srv/site
            header Cache-Control no-store
            header Content-Security-Policy "default-src 'none'; frame-ancestors 'none'"
            file_server
        }
        respond 404
    }
}
